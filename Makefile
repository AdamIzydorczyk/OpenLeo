	$(XC) -O1 -std=gnu11 -Wall -Wextra -Iported -o $@ \
	    tools/pcm_selftest.c ported/ll_pcm.c

# ll_level: level-scene viewer - prints a level's .DES wiring, composites
# its tlo= PCX background + ANIMACJE leaf .SEQ object sprites driven by the
# HD-install .MOV state machines (LEO_HD_DIR=<dir with ANIMACJE/ETAPY>).
ll_level: tools/ll_level.c ported/ll_level.c ported/ll_play.c ported/llrs.c ported/ll_pcx.c ported/ll_pcm.c \
        ported/ll_seq.c ported/ll_mod.c ported/fs_ci.c ported/ll_view.c ported/ll_audio.c \
        ported/platform_sdl.c ported/platform_common.c \
        ported/ll_seq.h ported/ll_pcm.h ported/ll_mod.h ported/ll_config.h ported/fs_ci.h ported/ll_view.h ported/ll_audio.h ported/platform.h
	$(CC) -O2 -std=gnu11 -Wall -Wextra -Iported $(CFLAGS) -o $@ \
	    tools/ll_level.c ported/ll_level.c ported/ll_play.c ported/llrs.c ported/ll_pcx.c ported/ll_pcm.c \
	    ported/ll_seq.c ported/ll_mod.c ported/fs_ci.c ported/ll_view.c ported/ll_audio.c \
	    ported/platform_sdl.c ported/platform_common.c $(LIBS)

ll_save: tools/ll_save.c ported/ll_save.c ported/ll_save.h ported/fs_ci.c
	$(CC) -O1 -std=gnu11 -Wall -Wextra -Iported -o $@ tools/ll_save.c \
	    ported/ll_save.c ported/fs_ci.c

ll_save.exe: tools/ll_save.c ported/ll_save.c ported/ll_save.h ported/fs_ci.c
	$(XC) -O1 -std=gnu11 -Wall -Wextra -Iported -o $@ tools/ll_save.c \
	    ported/ll_save.c ported/fs_ci.c

level: ll_level
	./ll_level $(DATA) $(LEVEL) $(ARGS)

verify-llrs: llrs_selftest
ifeq ($(PX_DATA),1)
	@for F in ANIMACJE ETAPY SOUND LEVELDES; do \
	  ./llrs_selftest $(DATA)/$$F > /tmp/opencode/llrs_c_$$F.txt \
	    || { echo "$$F: C side FAILED (container unreadable)"; exit 1; }; \
	  python3 tools/llrs_unpack.py list $(DATA)/$$F > /tmp/opencode/llrs_py_$$F.txt 2>/dev/null \
	    || { echo "$$F: python side FAILED (container unreadable)"; exit 1; }; \
	  [ -s /tmp/opencode/llrs_c_$$F.txt ] \
	    || { echo "$$F: EMPTY listing (vacuous diff refused)"; exit 1; }; \
	  if cmp -s /tmp/opencode/llrs_c_$$F.txt /tmp/opencode/llrs_py_$$F.txt; \
	  then echo "$$F: C == python (exact)"; \
	  else echo "$$F: MISMATCH"; exit 1; fi; done
	@echo "MENU index block (sparse 199-slot table, 39 used records):"
	@./llrs_selftest --block $(DATA)/ANIMACJE MENU > /tmp/opencode/menu_blk.txt
	@head -3 /tmp/opencode/menu_blk.txt
	@grep -q 'MENU: 199 table slots, 39 used records' \
	    /tmp/opencode/menu_blk.txt || \
	    { echo "verify-llrs: MENU sparse-table probe FAILED (want 199 slots / 39 used)"; exit 1; }
	@grep -q 'WYJSCIE.SEQ' /tmp/opencode/menu_blk.txt || \
	    { echo "verify-llrs: records past slot 38 NOT found (old truncated scan?)"; exit 1; }
	@echo "MENU sparse table ok (header count = used count; table extends past it)"
else
	@echo "verify-llrs: SKIP (the C-vs-python container comparison needs $(DATA) staged - see the restaging recipe in NEXT_STEPS.md)"
endif

# ported/ll_pcx.c byte-for-byte agreement with tools/pcx_dump.py on every PCX

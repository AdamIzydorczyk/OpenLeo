# PR-83 (two bug reports from the user's HD build): (1) the lion must not
# spawn in a CROUCH: the spawn state is the .MOV's declared start (ZARIA
# and TUNGA declare A_WALK, ENA declares A_SWIM), never block index 0 -
# on ZARIA block 0 is A_JUMP_DOWN, the crouch (the reported "too low" was
# art, not geometry: spawn pos matches the game exactly). (2) Input must
# be edge-honest: FWD walks, RELEASE stops (A_WALK's !K_FWD -> A_DRAP +
# the BY_X brake F=100), and BKWD plays A_TURN ONCE: while a key is held
# its self-transition keeps the state, so A_TURN never loops to A_DRAP.
# Zero input here means LEO_PLAY_SCRIPT="1:NONE" - the leg default of
# "1:FWD" would be a held key.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:NONE" LEO_LEVEL_PPM=/tmp/opencode/ly_zidle.ppm \
	  LEO_LEVEL_PPM_TICK=100 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zidle.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA start/idle FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zidle.log; exit 1; fi
	@grep -q 'play tick 1: state A_WALK seq walk frame 1 pos 50,680 grounded 1' \
	      /tmp/opencode/ly_zidle.log \
	  && grep -q 'play: A_WALK -> A_DRAP' /tmp/opencode/ly_zidle.log \
	  && grep -q 'play tick 100: state A_DRAP seq idle frame 1 pos 50,680' \
	      /tmp/opencode/ly_zidle.log \
	  && echo "play start state: ZARIA.01 spawns STANDING in the declared A_WALK, the frame GEN AC_TIME chain drops him to the A_DRAP idle, and zero input never creeps (ok)" \
	  || { echo "play ZARIA start/idle grep FAILED"; cat /tmp/opencode/ly_zidle.log; \
	    exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD 100:NONE 130:BKWD" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zkeys.ppm \
	  LEO_LEVEL_PPM_TICK=135 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zkeys.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA press/release FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zkeys.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_DRAP' /tmp/opencode/ly_zkeys.log \
	  && grep -q 'play: A_DRAP -> A_TURN' /tmp/opencode/ly_zkeys.log \
	  && test "$$(grep -c '> A_TURN' /tmp/opencode/ly_zkeys.log)" -eq 1 \
	  && grep -q 'play tick 135: state A_TURN seq turn frame -5 pos 9[0-9],680 grounded 1' \
	      /tmp/opencode/ly_zkeys.log \
	  && echo "play input edges: FWD walks ~39 px by tick 100 (T=20 px/s), releasing brakes him into the A_DRAP idle, BKWD at 130 plays A_TURN once and STAYS held (no crouch-loop while held); the held key then WALKS him left - pinned by the left-walk leg below (PR-85) (ok)" \
	  || { echo "play ZARIA press/release grep FAILED"; cat /tmp/opencode/ly_zkeys.log; \
	    exit 1; }
# PR-84 camera anchor (the owner's "the lion sits lower than the
# original"): the ORIGINAL keeps a grounded lion's feet at ~178 of the
# 200-row view (gp.mp4 t=205.0s frame measured by colour split: paws
# 133..180; PR-72's 5150-frame mode 175 included the shadow). ZARIA.01
# has NO back_rect, its reference layer PLAN1 is 2240x700 -> cam_ymax
# 500, and the original's camy for the ground at world y=680 IS exactly
# that clamp (feet 180). The old 65%-anchor rule put the feet at 199.
# Pins below measure the DRAWN lion with tools/ppm_lion_measure.py in a
# window around his logged position; top/bottom are the art's own edges
# (pose-dependent - A_TURN's tail paints below the feet point), pinned
# with +-6: loose enough to ignore pose details, tight enough to catch
# the 19 px regression this PR fixes (PR-72 measured at 10 px precision
# on 4829 frames - 6 is the honest margin for one uncompressed frame).
	@python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zkeys.ppm \
	  72 122 100 200 orange top=128+-6 bottom=199+-6 \
	  || { echo "play cam-y A_TURN anchor grep FAILED"; \
	    grep 'tick 135' /tmp/opencode/ly_zkeys.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zcam.ppm LEO_LEVEL_PPM_TICK=135 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zcam.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA cam-y leg FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zcam.log; exit 1; fi
	@X=$$(grep -o 'play tick 135: state A_WALK seq walk frame [0-9-]* pos [0-9]*,680' \
	    /tmp/opencode/ly_zcam.log | sed 's/.*pos \([0-9]*\),.*/\1/'); \
	  grep -q 'play tick 135: state A_WALK seq walk frame .* pos 10[0-9],680 grounded 1' \
	    /tmp/opencode/ly_zcam.log \
	  && python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zcam.ppm \
	      $$((X-25)) $$((X+25)) 100 200 orange top=137+-6 bottom=199+-6 \
	  && echo "play cam-y: a GROUNDED lion's drawn art sits at the measured anchor (feet ~178 of 200), == the original frame; A_TURN + walk poses both pinned (ok)" \
	  || { echo "play ZARIA cam-y anchor check FAILED"; cat /tmp/opencode/ly_zcam.log; \
	    exit 1; }
# PR-85 left-walk (the owner's "the left key turns but he never walks
# left, slides more than it walks, and slow"): Model M - K_FWD/K_BKWD
# are FACING-RELATIVE (recorded in ll_play.c cond_true: ZARIA authors
# ONE walk state and no backward-walk state, so literal keys could
# never walk left at all). Held BKWD from face=+1: A_DRAP -> A_TURN
# (the turn, its CH_DIR flips face=-1), the frame-list WRAP arms
# AC_BREAK_NEXT - A_TURN's OWN exit line (the real .MOV lists only
# AC_BREAK_NEXT/PREV) - back to the A_DRAP hub, and there the held
# LEFT key IS K_FWD at face=-1: A_WALK walks LEFT. Pins: A_TURN entered
# EXACTLY once, the hub hand-off, and x DECREASING while walking
# (74 -> 64 in 24 ticks = the authored T=20 u/s cap - "slides more
# than it walks" is gone: the A_TURN F=0 slide hands over into real
# walking), plus the drawn art at the PR-84 anchor in the MIRRORED
# walk pose (window built from the logged position, zcam method).
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_PLAY_SCRIPT="1:FWD 100:NONE 130:BKWD" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zwalk.ppm LEO_LEVEL_PPM_TICK=205 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zwalk.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA left-walk FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zwalk.log; exit 1; fi
	@test "$$(grep -c '> A_TURN' /tmp/opencode/ly_zwalk.log)" -eq 1 \
	  && grep -q 'play: A_TURN -> A_DRAP' /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play: A_DRAP -> A_WALK' /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play tick 181: state A_WALK seq walk .* pos 7[0-9],680 grounded 1' \
	      /tmp/opencode/ly_zwalk.log \
	  && grep -q 'play tick 205: state A_WALK seq walk .* pos 6[0-9],680 grounded 1' \
	      /tmp/opencode/ly_zwalk.log \
	  || { echo "play ZARIA left-walk grep FAILED"; cat /tmp/opencode/ly_zwalk.log; exit 1; }
	@X=$$(grep -o 'play tick 205: state A_WALK seq walk frame [0-9-]* pos [0-9]*,680' \
	    /tmp/opencode/ly_zwalk.log | sed 's/.*pos \([0-9]*\),.*/\1/'); \
	  python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zwalk.ppm \
	    $$((X-20)) $$((X+28)) 100 200 orange top=128+-6 bottom=199+-6 \
	  && echo "play left-walk (PR-85 Model M): held BKWD turns ONCE (AC_BREAK_NEXT at the A_TURN list wrap - its own exit line), then A_WALK walks LEFT at the T=20 cap, mirrored art stays on the measured cam anchor (ok)" \
	  || { echo "play ZARIA left-walk cam-y grep FAILED"; grep 'tick 20[05]' /tmp/opencode/ly_zwalk.log; exit 1; }
# PR-86 jump: the (N) token decoded as the TARGET's START ROW (evidence
# in ll_mov_tr.entry) and a state that DECLARES an AC_BREAK_NEXT exit
# ends at its own frame-list WRAP - the landing no longer cuts the jump
# state (the old forced-idle stays only as a fallback for states
# without such a line; the JM selftest fixture covers that branch).
# ZARIA.01 walk + one JUMP press pins the full authored flow: apex at
# the PR-73-measured height (~24 u, view y 656; I 150,-1200 / 4 with
# g=1650 -> -300 u/s: the model was already faithful - "jumps very low"
# complaint NOT reproduced, see NEXT_STEPS PR-86); landing INSIDE the
# state (ticks 125+, no A_DRAP anywhere - grep -v pins its absence);
# recovery rows play out (A_JUMP row 6 = the 900 ms crouch); the wrap
# at ~1975 ms arms AC_BREAK_NEXT -> A_WALK(7) = the walk cycle's ROW 7
# re-join (frame cursor 7, NOT 1), and the drawn art sits on the PR-84
# anchor there too (measured top=128 bottom=199, zcam window method).
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=3 \
	  LEO_PLAY_SCRIPT="1:FWD 100:JUMP 130:NONE" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zjump.ppm LEO_LEVEL_PPM_TICK=212 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zjump.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA jump FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zjump.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_JUMP' /tmp/opencode/ly_zjump.log \
	  && grep -q 'play tick 114: state A_JUMP seq jump .* pos 90,65[4-7] grounded 0' \
	      /tmp/opencode/ly_zjump.log \
	  && grep -q 'play tick 135: state A_JUMP seq jump .* grounded 1' \
	      /tmp/opencode/ly_zjump.log \
	  && ! grep -q 'A_JUMP -> A_DRAP' /tmp/opencode/ly_zjump.log \
	  && grep -q 'play: A_JUMP -> A_WALK' /tmp/opencode/ly_zjump.log \
	  && grep -q 'play tick 212: state A_WALK seq walk frame 7 .* grounded 1' \
	      /tmp/opencode/ly_zjump.log \
	  || { echo "play ZARIA jump grep FAILED"; cat /tmp/opencode/ly_zjump.log; exit 1; }
	@X=$$(grep -o 'play tick 212: state A_WALK seq walk frame 7 pos [0-9]*,[0-9]*' \
	    /tmp/opencode/ly_zjump.log | sed 's/.*pos \([0-9]*\),.*/\1/'); \
	  python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zjump.ppm \
	      $$((X-20)) $$((X+28)) 100 200 orange top=128+-6 bottom=199+-6 \
	  && echo "play jump (PR-86): apex ~24u on the measured model, landing INSIDE the authored jump state (no forced idle), wrap exits via its OWN A_WALK(7)=AC_BREAK_NEXT re-joining the walk cycle at row 7, art on the cam anchor (ok)" \
	  || { echo "play ZARIA jump cam-y grep FAILED"; grep 'tick 21[02]' /tmp/opencode/ly_zjump.log; exit 1; }
# PR-87: the fire-family keys + comma-group AND semantics on REAL data.
# ZARIA's attack entry is literally `A_FIGHT(1)=K_FIRE,K_F1` ("fire
# WHILE weapon 1 is selected" - the AND reading is argued in
# ll_play.h). Pins: FIRE,F1 (script comma token, mirroring the .MOV
# group) enters A_FIGHT from the idle hub and the punch frames play
# (300 ms rows: frame 5 by tick 100); the drawn punch sits on the
# PR-84 anchor (measured top=128 bottom=199, x range wider - the FC
# rows aim the punch right, the FC accumulator itself stays T1); and
# FIRE alone does NOT fight (negative leg - under the old
# OR/never-true readings this pair of pins was impossible).
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=3 \
	  LEO_PLAY_SCRIPT="50:FIRE,F1" \
	  LEO_LEVEL_PPM=/tmp/opencode/ly_zfight.ppm LEO_LEVEL_PPM_TICK=100 \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zfight.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA fight FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zfight.log; exit 1; fi
	@grep -q 'play: A_WALK -> A_DRAP' /tmp/opencode/ly_zfight.log \
	  && grep -q 'play: A_DRAP -> A_FIGHT' /tmp/opencode/ly_zfight.log \
	  && grep -q 'play tick 100: state A_FIGHT seq fight frame 5 pos 5[0-3],680 grounded 1' \
	      /tmp/opencode/ly_zfight.log \
	  && python3 tools/ppm_lion_measure.py /tmp/opencode/ly_zfight.ppm \
	      30 90 100 200 orange top=128+-6 bottom=199+-6 \
	  || { echo "play ZARIA fight grep FAILED"; grep 'tick 100' /tmp/opencode/ly_zfight.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_PLAY_SCRIPT="50:FIRE 60:NONE" \
	  ./ll_level $(DATA) ZARIA.01 --play --no-audio \
	  > /tmp/opencode/ly_zfire.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ZARIA fire-alone FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_zfire.log; exit 1; fi
	@test "$$(grep -c 'A_FIGHT' /tmp/opencode/ly_zfire.log)" -eq 0 \
	  && echo "play fight (PR-87): K_FIRE,K_F1 comma group ANDs - FIRE,F1 enters the authored A_FIGHT with its punch frames on the cam anchor, FIRE alone never fights (ok)" \
	  || { echo "play ZARIA fire-alone negative leg FAILED (A_FIGHT appeared)"; \
	    grep A_FIGHT /tmp/opencode/ly_zfire.log; exit 1; }
# PR-83: the KEYUP half of the input contract. No backend ever translated
# SDL_KEYUP, so through the REAL backend every key stuck down forever: the
# reported "controls press themselves in a loop". The live loop (NO
# LEO_LEVEL_PPM: the fixed-grid legs bypass platform_poll, which is why
# this bug was invisible to them) drives one key through the SDL event
# queue - LEO_TEST_KEY at 50 ms, LEO_TEST_KEY_UP_AFTER_MS release at
# 1300 ms - and pins BOTH edges: A_STAY -> A_WALK_FWD on press,
# A_WALK_FWD -> A_STAY on release.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2.2 \
	  LEO_TEST_KEY=right LEO_TEST_KEY_AFTER_MS=50 LEO_TEST_KEY_UP_AFTER_MS=1300 \
	  timeout 10 ./ll_level $(DATA) RAN.01 --play --no-audio \
	  > /tmp/opencode/ly_keyup.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play key release FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_keyup.log; exit 1; fi
	@grep -q 'play: A_STAY -> A_WALK_FWD' /tmp/opencode/ly_keyup.log \
	  && grep -q 'play: A_WALK_FWD -> A_STAY' /tmp/opencode/ly_keyup.log \
	  && test "$$(grep -c '> A_WALK_FWD' /tmp/opencode/ly_keyup.log)" -eq 1 \
	  && echo "play key release: a real SDL_KEYUP stops the walk (A_WALK_FWD -> A_STAY through !K_FWD) - the reported sticky-input loop is gone (ok)" \
	  || { echo "play key release grep FAILED"; cat /tmp/opencode/ly_keyup.log; exit 1; }
# the SAME runtime on the other level blocks that carry complete player
# sets (inventory measured 2026-11-16 over the full CD + HD-install
# trees: 12 of 13 run their own LEW.* art + .MOV + their own ground;
# the ground is a .PLT for most and a sub-.des for two - see the leg
# below. KADMAR.07's lion lives in an ANIMACJE leaf literally named
# "0", which its .des names exactly, so it runs too).
# ENA.03 additionally pins the '!' point-separator variant (ENA.PLT) on
# real bytes: without it that ground parsed to zero lines.
	@for L in ENA.03 ENA2 KARA.07 KADMAR.07 KADMAR2 LONA.05 ZARIA.01 ZARIA.02; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_multi_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=30 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_multi_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play multi-level $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; fi; \
	  grep -qE 'play: [A-Za-z0-9_.]+ [0-9]+ state\(s\) on [0-9]+ polyline' \
	      /tmp/opencode/ly_multi_$$L.log || { echo "play multi-level $$L not wired"; \
	    cat /tmp/opencode/ly_multi_$$L.log; exit 1; }; \
	  grep -qE 'play tick 30: state A_' /tmp/opencode/ly_multi_$$L.log || \
	    { echo "play multi-level $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: ENA.PLT: 1 polyline' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'spawn feet (100,560) grounded=1' /tmp/opencode/ly_multi_ENA.03.log \
	  && grep -q 'play tick 30: state A_SWIM' /tmp/opencode/ly_multi_ENA.03.log \
	  && echo "play multi-level: 8 more levels run their OWN lion data (zero special-casing); ENA.PLT '!' separator + the ENA.03 A_SWIM state prove the extended grammar on real bytes" \
	  || { echo "play multi-level ENA.03 grep FAILED"; cat /tmp/opencode/ly_multi_ENA.03.log; exit 1; }
# PR-44: the SECOND real form of `platformy=`. Two level blocks point it
# at a sub-.des of their own block instead of a .PLT, and that record's
# TEXT is the very same polyline grammar (count header and all): TUNGA2.12
# and SADES.06 say platf.des, whose PLATF.DES record starts
# "66\r\n1 1495,147;..." / "8\r\n1 863,166;...". Same parser, so these
# two levels run their own lion on their own ground - no special casing.
	@for L in TUNGA2.12 SADES.06; do \
	  env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	    LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 \
	    LEO_LEVEL_SECS=1 LEO_PLAY_SCRIPT="1:FWD" \
	    LEO_LEVEL_PPM=/tmp/opencode/ly_desground_$$L.ppm \
	    LEO_LEVEL_PPM_TICK=30 \
	    ./ll_level $(DATA) $$L --play --no-audio \
	    > /tmp/opencode/ly_desground_$$L.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play ground-from-.des $$L FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; fi; \
	  grep -q 'play: PLATF.DES: [0-9]* polyline' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: ground not read"; \
	    cat /tmp/opencode/ly_desground_$$L.log; exit 1; }; \
	  grep -qE 'spawn feet \([0-9]+,[0-9]+\) grounded=1' /tmp/opencode/ly_desground_$$L.log \
	    || { echo "play ground-from-.des $$L: spawn not snapped on it"; exit 1; }; \
	  grep -qE 'play tick 30: state A_' /tmp/opencode/ly_desground_$$L.log || \
	    { echo "play ground-from-.des $$L never ran a state"; exit 1; }; \
	done
	@grep -q 'play: PLATF.DES: 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'LEW.TUN 33 state(s) on 66 polyline' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'spawn feet (50,320) grounded=1' /tmp/opencode/ly_desground_TUNGA2.12.log \
	  && grep -q 'play: PLATF.DES: 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'LEW.SAD 37 state(s) on 8 polyline' /tmp/opencode/ly_desground_SADES.06.log \
	  && grep -q 'spawn feet (20,166) grounded=1' /tmp/opencode/ly_desground_SADES.06.log \
	  && echo "play ground-from-.des: platformy= has TWO real forms (a .PLT, or a sub-.des holding the same polylines) - both levels now run their own lion on their own ground" \
	  || { echo "play ground-from-.des exact-count grep FAILED"; \
	    cat /tmp/opencode/ly_desground_TUNGA2.12.log /tmp/opencode/ly_desground_SADES.06.log; \
	    exit 1; }
# ...and the THIRD answer a level can give: JUNCTION says platformy=none.des
# and its NONE.DES record is literally "0". That is an AUTHORED empty
# ground (the level has no floor), not a missing file, so it must print as
# "has NO ground in its own data" and never as the "lacks"/"no .PLT" data
# hole. Same rule for the bare `none` keyword in the other .des lists
# (JUNCTION animacje=none, RAN.01 zwierzaki=...,none): it means "nothing
# here", so no false 'not in the HD level block (data hole)' note and no
# invented placements from the fallback scan.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_PLAY_SCRIPT="1:FWD" LEO_LEVEL_PPM=/tmp/opencode/ly_noground.ppm \
	  LEO_LEVEL_PPM_TICK=30 \
	  ./ll_level $(DATA) JUNCTION --play --no-audio \
	  > /tmp/opencode/ly_noground.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "play JUNCTION authored-empty FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/ly_noground.log; exit 1; fi
	@grep -q 'play: NONE.DES: 0 polyline' /tmp/opencode/ly_noground.log \
	  && grep -q 'has NO ground in its own data' /tmp/opencode/ly_noground.log \
	  && grep -q 'authored scene JUNCTION: 0 placement file(s), 0 object' \
	      /tmp/opencode/ly_noground.log \
	  && ! grep -q 'lacks ground' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'not in the HD level block' /tmp/opencode/ly_noground.log \
	  && ! grep -q 'll_level: placement' /tmp/opencode/ly_noground.log \
	  && echo "play authored-empty ground: platformy=none.des = '0' is DATA (no floor), reported as such, and the bare 'none' keyword is never a fake data hole" \
	  || { echo "play authored-empty ground grep FAILED"; cat /tmp/opencode/ly_noground.log; \
	    exit 1; }
# per-level data: TUNGA.11 has its OWN complete player set (LEW.TUN art,

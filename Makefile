	    exit 1; fi
	@grep -q 'play tick 31: LICHA/licha3.mov DANGER: lion within the class' \
	    /tmp/opencode/ly_dgr.log \
	  && grep -q 'play tick 38: first touch raises AC_ENEMY on LICHA/licha3.mov' \

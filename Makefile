# Level scene: TUNGA.11 = PLAN3.PCX bg + MOVEPLAT leaf .SEQ sprite animated
# Level scene (PR-45): the level's OWN placement data drives the scene.
# TUNGA.11 reads the 7 placement files its main .des names through
# zwierzaki=/animacje=/ani_plat=, places 69 of its 77 authored object entries
# (8 stand at an x outside the world its own back_rect defines), and joins each
# entry to its HD .MOV script AND to the .SEQ art that script selects for the
# state it plays (the per-state seq= name, not the .mov stem). Fixed-tick PPM
# dumps must differ (motion) and must be composited over the bare background.
# LEO_HELP_SECS=0 skips the help overlay for the pure-scene dumps.
# (pcm_selftest stays a prerequisite for the sibling verify-pcm decoder
# oracle; RAN.01 itself renders the real PLAN3.PCX tlo layer since PR-36.)
verify-level: ll_level pcm_selftest
# FIX-13 (X-11): .MOV duration clamp + obj_advance cycle-guard selftest, plus
# the PR-45 per-state art selection (a state draws exactly the .SEQ its own
# seq= names; a missing name or a shape-only table draws nothing) -
# data-free, so it runs in EVERY configuration (full suite and the
# fixture-free CI simulation alike).
	@timeout 30 ./ll_level --mov-selftest
ifeq ($(PX_DATA),1)
	@rm -f /tmp/opencode/lv_tick2.ppm /tmp/opencode/lv_tick8.ppm
	@for T in 2 8 20; do env -u DISPLAY SDL_VIDEODRIVER=dummy \
	  SDL_AUDIODRIVER=dummy LEO_HD_DIR=$(HD) \
	  LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_LEVEL_PPM=/tmp/opencode/lv_tick$$T.ppm LEO_LEVEL_PPM_TICK=$$T \
	  ./ll_level $(DATA) TUNGA.11 > /tmp/opencode/lv_tick$$T.log 2>&1; \
	  rc=$$?; if [ $$rc -ne 0 ]; then echo "level scene FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_tick$$T.log; exit 1; fi; done
# the authored scene, read from the level's own data: 7 placement files, 77
# entry lines -> 68 placed + 1 authored at 0,0 (an attached child, PR-93) +
# 8 outside its own world, plus the PR-93 static image grammar: 18 lines
# -> 18 placed (the WODOSPAD waterfalls and the TABLICA signs: the line
# names its own .SEQ in that CD ANIMACJE leaf), 43 scripts / 50 art
# tables, ONE real art hole (ogien_m.SEQ), two stale count headers reported as
# what they are, and the bare `none` keyword of ani_plat= never a fake hole.
	@grep -q 'show TUNGA.11: bg PLAN3.PCX 640x359, 68 animated object(s), 18 static image(s)' \
	    /tmp/opencode/lv_tick8.log \
	  && grep -q 'authored scene TUNGA.11: 18 static image line(s).*-> 18 placed' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'obj WODOSPAD/wodos1.seq\[static image\]: art WODOS1.SEQ, 0 state(s), bbox 32x394 at (168,185)' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'authored scene TUNGA.11: 7 placement file(s), 77 object' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'placement ANI3.DES (72 B, from animacje=)' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'its own count line says 20 but the file holds 10 entry' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q "the ani_plat list carries the bare 'none' keyword" \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'obj ANIBACK/strum2.mov\[mov\]: art STRUM2.SEQ, 1 state(s), bbox 230x187 at (1494,503)' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'its seq= names ogien_m.SEQ in that ANIMACJE leaf: no such record' \
	      /tmp/opencode/lv_tick8.log \
	  && grep -q 'hud: belka.des: 5 item(s)' /tmp/opencode/lv_tick8.log \
	  && echo "authored scene: .des placement files -> placed objects, art chosen by each script's own seq=, stale count lines and data holes named exactly (ok)" \
	  || { echo "authored scene grep FAILED"; cat /tmp/opencode/lv_tick8.log; exit 1; }
# the scripts really run: the engine's OWN record step, ONE per tick,
# advances the cycle, and the proof lines name the script (not a guessed
# .SEQ name) and say which state and frame of it is showing
# (PR-110 re-pinned the two frame numbers; PR-135 re-pins them, and the
# arithmetic is now a division. The fixed dump grid calls
# obj_advance(obj, LL_ITER_MS) exactly `ticks` times (ll_level.c:6821), so
# tick 8 is EIGHT record steps, each feeding the accumulator the engine's
# fixed 100 units (0x4c8b7) and admitting AT MOST ONE row (0x521f0). Both
# scripts here are BY_TIME lists of UNIFORM rows, read from the authored
# .MOV text of this leaf: STRUM1's [A_RUN] is nineteen rows of 500 units,
# STRUM2's twelve rows of 300 - so one row closes every 500/100 = 5
# iterations and every 300/100 = 3. After 8 steps STRUM1 has closed 1 row
# (the second would need 10) and draws list index 1; STRUM2 has closed 2
# (the third would need 9) and draws list index 2. WODOS2's list, which
# the same proof block prints, is 100,300,300,300,300 with a `goto 2`:
# three rows closed by step 8 -> frame 3, which is what those lines read.
# The old ms clock read the same row sizes as milliseconds - 500 ms and
# 300 ms of a 40 ms step - and answered 2 and 3.)
	@grep -q 'tick 8: ANIBACK/strum1.mov state 0 frame 1' \
	    /tmp/opencode/lv_tick8.log \
	  && grep -q 'tick 8: ANIBACK/strum2.mov state 0 frame 2' \
	    /tmp/opencode/lv_tick8.log \
	  && grep -q 'tick 8: 74 more placement(s) advanced' \
	      /tmp/opencode/lv_tick8.log \
	  && echo "scene animation: the authored .MOV cycles advance one record step per tick, their uniform 500- and 300-unit rows closing every 5 and 3 of them (proof bounded at 12 placements, ok)" \
	  || { echo "scene animation grep FAILED"; cat /tmp/opencode/lv_tick8.log; exit 1; }
	@if tools/frames_differ.sh /tmp/opencode/lv_tick2.ppm /tmp/opencode/lv_tick20.ppm; \
	then echo "level anim: the authored scene changes on screen (tick2 != tick20, ok)"; \
	else echo "level anim FAILED: tick2 == tick20"; exit 1; fi
# LEO_OBJ_ALL=1 prints EVERY placement (the default listing is bounded at 24):
# proof that the platform script the old build knew (ED000002, 5 states) comes
# from the level's own ani_plat data, at its authored coordinates
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_OBJ_ALL=1 \
	  ./ll_level $(DATA) TUNGA.11 > /tmp/opencode/lv_objall.log 2>&1; \
	  rc=$$?; if [ $$rc -ne 0 ]; then echo "LEO_OBJ_ALL leg FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_objall.log; exit 1; fi
	@grep -q 'obj MOVEPLAT/ed000002.mov\[mov\]: art ED000002.SEQ, 5 state(s), bbox 80x298 at (599,164)' \
	    /tmp/opencode/lv_objall.log \
	  && ! grep -q 'more placement(s) of those scripts' \
	      /tmp/opencode/lv_objall.log \
	  && echo "LEO_OBJ_ALL: all 68 + 18 placements named, the animated platform comes from ani_plat= with its authored x,y (ok)" \
	  || { echo "LEO_OBJ_ALL grep FAILED"; cat /tmp/opencode/lv_objall.log; exit 1; }
# PR-93: the two placement grammars the user's ZARIA.01 report led to. The
# 3-comma "<LEAF>,<name>.seq,x,y" lines ARE placed: ZARIA.01's 14 (the stone
# shelves the authored objects stand on - plan4 at 70,480 under the balloon at
# 78,460, plan3 at 180,515 under the ladder, plan6 at 287,430 under the
# vulture) all join on the CD ANIMACJE PICT leaf; the five-field entries
# authored at exactly 0,0 are NOT (measured: all 130 in the shipped data
# follow another entry - the vulture's carried jajo here - children the
# engine spawns from their parent, whose trigger is unresolved).
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_OBJ_ALL=1 \
	  ./ll_level $(DATA) ZARIA.01 > /tmp/opencode/lv_statics.log 2>&1; \
	  rc=$$?; if [ $$rc -ne 0 ]; then echo "PR-93 statics leg FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_statics.log; exit 1; fi
	@grep -q 'authored scene ZARIA.01: 14 static image line(s).*-> 14 placed, 0 at an x outside' \
	    /tmp/opencode/lv_statics.log \
	  && grep -q 'obj PICT/plan4.seq\[static image\]: art PLAN4.SEQ, 0 state(s), bbox 136x60 at (70,480)' \
	      /tmp/opencode/lv_statics.log \
	  && grep -q 'obj PICT/gniazd.seq\[static image\]: art GNIAZD.SEQ, 0 state(s), bbox 84x28 at (2140,270)' \
	      /tmp/opencode/lv_statics.log \
	  && grep -q 'show ZARIA.01: bg PLAN3.PCX .*51 animated object(s), 14 static image(s)' \
	      /tmp/opencode/lv_statics.log \
	  && grep -q '2 entry line(s) authored at 0,0.*children the engine spawns from their parent' \
	      /tmp/opencode/lv_statics.log \
	  && grep -q 'placement ZWIERZ1.DES: POCISK/jajo.mov is authored at 0,0' \
	      /tmp/opencode/lv_statics.log \
	  && ! grep -q 'obj POCISK/jajo.*at (0,0)' /tmp/opencode/lv_statics.log \
	  && echo "placement grammars: static .SEQ lines joined from the CD leaf and placed at their authored x,y, 0,0 entries joined but never instantiated (ok)" \
	  || { echo "PR-93 statics grep FAILED"; cat /tmp/opencode/lv_statics.log; exit 1; }
# PR-95: the rhino's pancake mat. A 3-comma static inside a bounded actor's
# property block is that actor's child: ZARIA.01 ZWIERZ1 `NOSOROG,...,1700,600
# ... bounds=/scope=/energy=60` then `PICT,panc.seq,20,29` is drawn attached to
# the rhino at parent (1700,600) + offset (20,29) = (1720,629), never at the
# literal (20,29) corner - that is why the rhino "stood on nothing". The report
# line names it; and no other level's top-level static is pulled to a parent.
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=1 \
	  LEO_OBJ_ALL=1 \
	  ./ll_level $(DATA) ZARIA.01 > /tmp/opencode/lv_panc.log 2>&1; \
	  rc=$$?; if [ $$rc -ne 0 ]; then echo "PR-95 panc leg FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_panc.log; exit 1; fi
	@grep -q 'obj PICT/panc.seq\[static image\]: art PANC.SEQ, 0 state(s), bbox 92x32 at (1720,629)' \
	    /tmp/opencode/lv_panc.log \
	  && grep -q 'static PICT/panc.seq follows NOSOROG right after it: an image the engine draws attached to that object at the offset (20,29), placed at the parent (1700,600) + offset = (1720,629)' \
	    /tmp/opencode/lv_panc.log \
	  && grep -q 'authored scene ZARIA.01: 14 static image line(s).*1 authored right after an object and drawn attached to it at the offset' \
	    /tmp/opencode/lv_panc.log \
	  && ! grep -q 'obj PICT/panc.seq.*at (20,29)' /tmp/opencode/lv_panc.log \
	  && env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	     LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=0.2 \
	     ./ll_level $(DATA) TUNGA.11 2>&1 | grep -q 'authored scene TUNGA.11:.*0 authored right after an object' \
	  && echo "attached static image: the rhino's mat joins the rhino it follows (parent + offset), a non-bounded entry's following static stays absolute (ok)" \
	  || { echo "PR-95 panc grep FAILED"; cat /tmp/opencode/lv_panc.log; exit 1; }
	@rm -f /tmp/opencode/lv_panc.log
	@rm -f /tmp/opencode/lv_cam300.ppm
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_LEVEL_CAM=300 \
	  LEO_LEVEL_PPM=/tmp/opencode/lv_cam300.ppm LEO_LEVEL_PPM_TICK=8 \
	  ./ll_level $(DATA) TUNGA.11 > /tmp/opencode/lv_cam300.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "scroll camera FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_cam300.log; exit 1; fi
	@grep -q 'world 2560x600 (back_rect 0,0), view 320x200, cam 300/2240' \
	    /tmp/opencode/lv_cam300.log \
	  && grep -q 'tick 8: ANIBACK/strum2.mov' /tmp/opencode/lv_cam300.log \
	  && tools/frames_differ.sh /tmp/opencode/lv_tick8.ppm /tmp/opencode/lv_cam300.ppm \
	  && echo "scroll camera: back_rect world, world-X strum2 placement, backdrop and objects scroll over it (ok)" \
	  || { echo "scroll camera check FAILED"; cat /tmp/opencode/lv_cam300.log; exit 1; }
	@env -u DISPLAY SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy \
	  LEO_HD_DIR=$(HD) LEO_HELP_SECS=0 LEO_LEVEL_SECS=2 \
	  LEO_LEVEL_PPM=/tmp/opencode/lv_ran.ppm LEO_LEVEL_PPM_TICK=2 \
	  ./ll_level $(DATA) RAN.01 > /tmp/opencode/lv_ran.log 2>&1; rc=$$?; \
	  if [ $$rc -ne 0 ]; then echo "RAN.01 level scene FAILED (rc=$$rc)"; \
	    cat /tmp/opencode/lv_ran.log; exit 1; fi
# the largest authored scene in the shipped game: 827 entries from 4 placement
# files (CHMURY.DES from zwierzaki=) -> 826 placed + 1 authored at 0,0 (the
